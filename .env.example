# Copy to .env and adjust. Every setting is optional; the defaults are shown.
# Never commit .env (it is git-ignored).

# SQLite database file (created automatically).
APIWATCH_DATABASE_URL=sqlite:///./data/apiwatch.db

# Development server binding. Keep 127.0.0.1: APIWatch has no authentication and is
# meant for a single local user. Do not expose it to untrusted networks.
APIWATCH_HOST=127.0.0.1
APIWATCH_PORT=8000

# Host header values the server answers to (comma-separated). Requests with any other
# Host are rejected, which blocks DNS-rebinding attacks from malicious web pages.
APIWATCH_TRUSTED_HOSTS=127.0.0.1,localhost

# DEVELOPMENT ONLY - allow monitoring loopback targets (localhost, 127.0.0.0/8, ::1),
# required for the local demo mock API. Private networks (10/8, 172.16/12, 192.168/16),
# link-local and cloud metadata addresses remain blocked even when enabled.
APIWATCH_ALLOW_LOCALHOST=false

# Optional comma-separated allowlist of monitor target hosts. Empty = any public host.
# Allowlisted hosts must still resolve to public addresses.
# Example: APIWATCH_ALLOWED_TARGET_HOSTS=api.example.com,*.example.org
APIWATCH_ALLOWED_TARGET_HOSTS=

# Maximum response bytes read when inspecting JSON (minimum 1024).
APIWATCH_MAX_RESPONSE_BYTES=1048576

# Run automatic checks. Set false to only run checks manually.
APIWATCH_SCHEDULER_ENABLED=true

# Consecutive DOWN checks that open an incident (minimum 1).
APIWATCH_INCIDENT_FAILURE_THRESHOLD=2

# Demo mock API (python -m demo.mock_api)
MOCK_API_PORT=8001
MOCK_SLOW_DELAY_SECONDS=1.5
